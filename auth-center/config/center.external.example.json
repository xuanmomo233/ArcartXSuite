{
  "schemaVersion": 1,
  "nonceCapacityPerNode": 120000,
  "commandCapacityPerNode": 1000000,
  "port": 25600,
  "database": "data/auth-center.sqlite",
  "external": {
    "port": 25601,
    "origin": "https://auth.example.net",
    "minecraftSessions": true,
    "providers": [
      {
        "realm": "network",
        "issuer": "https://id.example.net",
        "authorize": "https://id.example.net/authorize",
        "token": "https://id.example.net/token",
        "clientId": "axs-center",
        "secretEnvironment": "AXS_WEBSITE_OIDC_SECRET",
        "keyId": "replace-with-provider-key-id",
        "rsaPublicKey": "REPLACE_WITH_BASE64_X509_RSA_PUBLIC_KEY"
      }
    ],
    "launchers": [
      {
        "id": "example-launcher",
        "realm": "network",
        "redirect": "http://127.0.0.1:43981/callback"
      }
    ]
  },
  "realms": [
    {
      "id": "network",
      "minLength": 8,
      "gamePasswordEnabled": false,
      "maxLength": 128,
      "requireTerms": true,
      "termsVersion": "1",
      "termsLines": [
        "请遵守服务器规则，保护账号凭据。"
      ],
      "requireBinding": false,
      "timezone": "Asia/Shanghai",
      "loginTimeoutSeconds": 300
    }
  ],
  "nodes": [
    {
      "id": "lobby",
      "realm": "network",
      "audience": "lobby-node",
      "keyEnvironment": "AXS_AUTH_LOBBY_KEY",
      "scopes": [
        "auth"
      ]
    }
  ]
}
